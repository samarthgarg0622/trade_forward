# Chat to watch and chat to forward into
SOURCE_JID=917073261789@s.whatsapp.net
DEST_JID=919479373057@s.whatsapp.net

# Optional: any @lid identifiers WhatsApp has shown for the source contact
# (comma-separated, no spaces needed). See README for why this exists.
KNOWN_SOURCE_LIDS=270991011930164@lid

# Forwarding window (24h clock, local to TIMEZONE below)
WINDOW_START=09:10
WINDOW_END=15:45
# 0=Sunday ... 6=Saturday. Default below is Monday-Friday.
WINDOW_DAYS=1,2,3,4,5
TIMEZONE=Asia/Kolkata

# Where session credentials are stored. On Railway, point this at your
# mounted volume, e.g. /data/auth_info, so it survives redeploys.
AUTH_FOLDER=./auth_info

# Web server port (Railway sets this automatically, safe to leave unset there)
PORT=3000

# Optional: protects the /qr login page from random visitors.
# Visit /qr?secret=whatever-you-set-here to view it.
QR_SECRET=changeme
